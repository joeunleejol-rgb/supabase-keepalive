      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "com.amazon.mobile.shopping",
          "amazon",
          "kyobobook"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFBF3"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "supabaseUrl": "https://ojgxncvubiwxxnqmvibx.supabase.co",
      "supabaseAnonKey": "sb_publishable_KfunTXkJvWPo_Ovnpywmsw_mC_thnX4"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "알레르기 반응 사진을 첨부하기 위해 사진 라이브러리 접근이 필요합니다.",
          "cameraPermission": "알레르기 반응 사진을 촬영하기 위해 카메라 접근이 필요합니다."
        }
      ]
    ]
