[{"id":"b5ca4b06-da81-4c3f-aea5-80551bc0533d","name":"쌀","category":"grain","description":"이유식의 가장 기본이 되는 곡물입니다. 알레르기 유발이 적어 초기 이유식으로 가장 추천됩니다. 5배죽부터 시작해 점차 묽기를 줄입니다.","recommended_month":4,"icon_name":"Wheat","color_theme":"amber","sort_order":1,"created_at":"2026-06-29T13:42:37.97283+00:00","name_en":"Rice","description_en":"The most fundamental grain for baby food. Rarely causes allergies, making it the top recommendation for early-stage feeding. Start with a thin porridge and gradually thicken.","is_starter_recommended":true,"name_de":"Reis","name_fr":"Riz","name_it":"Riso"}, 
 {"id":"6a8e7b77-6bf1-4221-9872-fc191ea71b32","name":"현미","category":"grain","description":"백미보다 영양가가 높지만 소화가 다소 어려울 수 있습니다. 중기 이후부터 도입을 추천하며, 잘 불려 갈아 사용합니다.","recommended_month":6,"icon_name":"Wheat","color_theme":"orange","sort_order":2,"created_at":"2026-06-29T13:42:37.97283+00:00","name_en":"Brown Rice","description_en":"More nutritious than white rice but slightly harder to digest. Recommended from mid-stage; soak well and blend before use.","is_starter_recommended":false,"name_de":"Vollkornreis","name_fr":"Riz brun","name_it":"Riso integrale"}, 
 {"id":"78b3bb55-c163-4dcb-8ca0-1521d453e33c","name":"당근","category":"vegetable","description":"베타카로틴이 풍부한 대표적인 초기 이유식 채소입니다. 잘 익혀 곱게 갈아 사용하며, 알레르기 위험이 낮아 초기부터 도입 가능합니다.","recommended_month":5,"icon_name":"Carrot","color_theme":"orange","sort_order":3,"created_at":"2026-06-29T13:42:37.97283+00:00","name_en":"Carrot","description_en":"A classic early-stage vegetable rich in beta-carotene. Cook until soft and purée finely. Low allergy risk, suitable from the start.","is_starter_recommended":true,"name_de":"Karotte","name_fr":"Carotte","name_it":"Carota"}, 
 {"id":"48a8b473-78bb-4060-8d7d-d74a053ff5a3","name":"단호박","category":"vegetable","description":"소화가 잘 되고 달콤한 맛으로 아기가 좋아하는 채소입니다. 베타카로틴과 식이섬유가 풍부하며, 초기부터 도입 가능합니다.","recommended_month":5,"icon_name":"Circle","color_theme":"amber","sort_order":4,"created_at":"2026-06-29T13:42:37.97283+00:00","name_en":"Kabocha Squash","description_en":"Easy to digest with a naturally sweet flavor babies love. Rich in beta-carotene and fiber; suitable from early stages.","is_starter_recommended":true,"name_de":"Hokkaido-Kürbis","name_fr":"Courge kabocha","name_it":"Zucca kabocha"}, 
 {"id":"795aeeb4-d6a9-4541-bf61-f4b2c433f8bd","name":"양배추","category":"vegetable","description":"위에 부담이 적고 소화가 잘 되는 채소입니다. 잘 익혀 곱게 갈아 사용하며, 중기 이후부터 다양하게 활용할 수 있습니다.","recommended_month":6,"icon_name":"Salad","color_theme":"green","sort_order":5,"created_at":"2026-06-29T13:42:37.97283+00:00","name_en":"Cabbage","description_en":"Gentle on the stomach and easy to digest. Cook thoroughly and purée finely; versatile from mid-stage onward.","is_starter_recommended":false,"name_de":"Weißkohl","name_fr":"Chou","name_it":"Cavolo"}, 
 {"id":"510992b2-3391-48d1-bdc5-ab389a653ece","name":"시금치","category":"vegetable","description":"철분과 비타민이 풍부하지만, 초기에는 소량부터 시작해야 합니다. 잘 데쳐서 곱게 다져 사용하며, 중기 이후 추천합니다.","recommended_month":6,"icon_name":"Leaf","color_theme":"green","sort_order":6,"created_at":"2026-06-29T13:42:37.97283+00:00","name_en":"Spinach","description_en":"Rich in iron and vitamins, though introduce in small amounts early on. Blanch and finely chop; recommended from mid-stage.","is_starter_recommended":false,"name_de":"Spinat","name_fr":"Épinard","name_it":"Spinaci"}, 
 {"id":"2837f136-a919-4a47-88f1-4815e546f8ff","name":"사과","category":"fruit","description":"알레르기 위험이 낮고 소화가 잘 되는 대표적인 초기 과일입니다. 잘 익혀 즙을 내거나 곱게 갈아 사용합니다.","recommended_month":5,"icon_name":"Apple","color_theme":"red","sort_order":7,"created_at":"2026-06-29T13:42:37.97283+00:00","name_en":"Apple","description_en":"A classic early-stage fruit with low allergy risk and easy digestibility. Cook and purée or press into juice.","is_starter_recommended":true,"name_de":"Apfel","name_fr":"Pomme","name_it":"Mela"}, 
 {"id":"692d30f0-30ef-4427-9e75-6da06e7755b6","name":"배","category":"fruit","description":"수분이 많고 소화가 잘 되는 과일입니다. 초기부터 도입 가능하며, 잘 익혀 즙을 내거나 곱게 갈아 줍니다.","recommended_month":5,"icon_name":"Cherry","color_theme":"green","sort_order":8,"created_at":"2026-06-29T13:42:37.97283+00:00","name_en":"Pear","description_en":"High in moisture and easy to digest. Suitable from early stages; cook and purée or juice.","is_starter_recommended":true,"name_de":"Birne","name_fr":"Poire","name_it":"Pera"}, 
 {"id":"aba3e5e6-e8c3-418c-9d8b-a267f808f16c","name":"바나나","category":"fruit","description":"칼륨이 풍부하고 부드러워 으깨기 쉬운 과일입니다. 중기 이후부터 아기가 직접 잡고 먹을 수 있어 BLW에도 적합합니다.","recommended_month":6,"icon_name":"Citrus","color_theme":"yellow","sort_order":9,"created_at":"2026-06-29T13:42:37.97283+00:00","name_en":"Banana","description_en":"Rich in potassium and soft enough to mash easily. From mid-stage, babies can self-feed banana pieces — great for BLW.","is_starter_recommended":false,"name_de":"Banane","name_fr":"Banane","name_it":"Banana"}, 
 {"id":"ed96bc84-69a0-4ed2-bfa8-54b3b86c5115","name":"아보카도","category":"fruit","description":"건강한 지방과 영양소가 풍부한 과일입니다. 중기 이후부터 추천하며, 으깨어 사용하거나 BLW용으로 적합합니다.","recommended_month":6,"icon_name":"Circle","color_theme":"green","sort_order":10,"created_at":"2026-06-29T13:42:37.97283+00:00","name_en":"Avocado","description_en":"Packed with healthy fats and nutrients. Recommended from mid-stage; mash or use as BLW finger food.","is_starter_recommended":false,"name_de":"Avocado","name_fr":"Avocat","name_it":"Avocado"}, 
 {"id":"09b502cf-bd53-49d8-ba2e-9385dd739d05","name":"소고기","category":"protein","description":"철분과 단백질이 풍부해 중기 이후 필수 재료입니다. 잘 익혀 곱게 갈아 사용하며, 알레르기 반응을 주의깊게 관찰해야 합니다.","recommended_month":7,"icon_name":"Beef","color_theme":"red","sort_order":11,"created_at":"2026-06-29T13:42:37.97283+00:00","name_en":"Beef","description_en":"Essential from mid-stage for iron and protein. Cook well and purée finely; watch carefully for any allergic reaction.","is_starter_recommended":false,"name_de":"Rindfleisch","name_fr":"Bœuf","name_it":"Manzo"}, 
 {"id":"322f5fc2-c7df-4d83-a17c-404de094d7d4","name":"닭고기","category":"protein","description":"소화가 잘 되는 단백질 공급원입니다. 중기 이후부터 추천하며, 잘 익혀 곱게 다져 사용합니다.","recommended_month":7,"icon_name":"Bird","color_theme":"amber","sort_order":12,"created_at":"2026-06-29T13:42:37.97283+00:00","name_en":"Chicken","description_en":"An easily digestible protein source. Recommended from mid-stage; cook thoroughly and mince finely.","is_starter_recommended":false,"name_de":"Hähnchenfleisch","name_fr":"Poulet","name_it":"Pollo"}, 
 {"id":"df0551b1-8217-40df-ab14-cc5e39799024","name":"흰살생선","category":"protein","description":"단백질과 DHA가 풍부하지만 알레르기 위험이 있어 주의가 필요합니다. 중기 이후 소량부터 시작하며, 흰살생선(대구, 가자미 등)을 추천합니다.","recommended_month":8,"icon_name":"Fish","color_theme":"sky","sort_order":13,"created_at":"2026-06-29T13:42:37.97283+00:00","name_en":"White Fish","description_en":"Rich in protein and DHA, but has allergy potential — introduce cautiously. Start with small amounts from mid-stage; white fish like cod or flounder are good choices.","is_starter_recommended":false,"name_de":"Weißfisch","name_fr":"Poisson blanc","name_it":"Pesce bianco"}, 
 {"id":"e5ed0bf3-fc02-45c9-bdc9-d4f43ced85d5","name":"계란노른자","category":"protein","description":"철분과 단백질이 풍부합니다. 중기 이후 노른자부터 시작해 후기에 흰자를 도입합니다. 알레르기 주의가 필요한 재료입니다.","recommended_month":7,"icon_name":"Egg","color_theme":"yellow","sort_order":14,"created_at":"2026-06-29T13:42:37.97283+00:00","name_en":"Egg Yolk","description_en":"Rich in iron and protein. Start with yolk from mid-stage and introduce white in late-stage. An allergy-prone ingredient — monitor closely.","is_starter_recommended":false,"name_de":"Eigelb","name_fr":"Jaune d'œuf","name_it":"Tuorlo d'uovo"}, 
 {"id":"7ced5677-a9f8-49ad-97f7-7478e71b6e8e","name":"두부","category":"protein","description":"식물성 단백질 공급원으로 소화가 잘 됩니다. 중기 이후부터 추천하며, 곱게 으깨어 사용합니다.","recommended_month":7,"icon_name":"Square","color_theme":"neutral","sort_order":15,"created_at":"2026-06-29T13:42:37.97283+00:00","name_en":"Tofu","description_en":"A plant-based protein that's easy to digest. Recommended from mid-stage; mash finely.","is_starter_recommended":false,"name_de":"Tofu","name_fr":"Tofu","name_it":"Tofu"}, 
 {"id":"9c5dc5c8-1244-4393-a3bf-2b425433f532","name":"감자","category":"vegetable","description":"탄수화물과 비타민 C가 풍부한 식재료입니다. 잘 익혀 곱게 으깨어 사용하며, 초기부터 도입 가능합니다.","recommended_month":5,"icon_name":"Circle","color_theme":"amber","sort_order":16,"created_at":"2026-06-29T13:42:37.97283+00:00","name_en":"Potato","description_en":"Rich in carbohydrates and vitamin C. Cook well and mash finely; suitable from early stages.","is_starter_recommended":true,"name_de":"Kartoffel","name_fr":"Pomme de terre","name_it":"Patata"}, 
 {"id":"89ba04eb-ae07-41e3-aff0-db54ac524eb7","name":"고구마","category":"vegetable","description":"식이섬유와 베타카로틴이 풍부합니다. 달콤한 맛으로 아기가 좋아하며, 잘 익혀 곱게 으깨어 사용합니다.","recommended_month":5,"icon_name":"Circle","color_theme":"orange","sort_order":17,"created_at":"2026-06-29T13:42:37.97283+00:00","name_en":"Sweet Potato","description_en":"Rich in fiber and beta-carotene with a sweet taste babies enjoy. Cook well and mash finely.","is_starter_recommended":true,"name_de":"Süßkartoffel","name_fr":"Patate douce","name_it":"Patata dolce"}, 
